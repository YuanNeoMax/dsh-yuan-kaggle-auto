{
  "name": "dsh-yuan-kaggle-auto",
  "version": "0.3.0",
  "description": "DSH 插件：把 Kaggle 竞赛全流程（下载 / 切分 / 基线 / LLM 特征工程迭代 / 融合 / 校验 / 提交 / 读榜分）交给 AI 全自动完成。内置 Python 引擎，首装一键初始化，附带可选的 ego 浏览器一键安装。",
  "type": "module",
  "author": "YuanNeo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanNeoMax/dsh-yuan-kaggle-auto.git"
  },
  "bugs": {
    "url": "https://github.com/YuanNeoMax/dsh-yuan-kaggle-auto/issues"
  },
  "homepage": "https://github.com/YuanNeoMax/dsh-yuan-kaggle-auto#readme",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "engine/kauto/*.py",
    "engine/tests/*.py",
    "engine/tools/*.py",
    "engine/fixtures/**",
    "engine/work/**",
    "engine/run_all_tests.py",
    "engine/requirements.lock.txt",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown -c tsdown.config.ts",
    "test": "vitest run",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kaggle",
    "automl",
    "competition",
    "lightgbm",
    "agent",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "dsh-ego-browser": "^0.9.11"
  }
}
